# Ponte Local — Relay (Next.js)
# Copie este arquivo para .env.local e preencha.
# NUNCA commite o .env.local (ja esta no .gitignore).

# Token admin (obrigatorio): o operador/IA usa para enfileirar comandos
# Gere com: openssl rand -hex 16
PONTE_ADMIN_TOKEN=

# Tokens das maquinas (uma lane por maquina).
# O sufixo do nome vira a lane (minusculas, so letras/numeros/_).
# Exemplos:
# PONTE_TOKEN_MAQUINA_1=token_da_maquina_1   -> lane "maquina_1"
# PONTE_TOKEN_MEU_PC=token_do_meu_pc         -> lane "meu_pc"
# PONTE_TOKEN_NOTEBOOK=token_do_note         -> lane "notebook"

# Legado (token unico, v1.4.0): ainda aceitos mas nao recomendados.
# PONTE_AGENT_TOKEN=     -> lane "netbook"
# PONTE_TEST_TOKEN=      -> lane "test"

# Pasta de dados do relay (opcional). Se nao definido, usa o cwd.
# Em container/VPS, aponte para um volume persistente.
# PONTE_DATA_DIR=/data/ponte-relay

# Porta do servidor (Next.js usa 3000 por padrao; esta variavel e so
# informativa para o painel).
# PORT=3000
